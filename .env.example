# ========================================
# Watchmen API - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# ========================================

# ==================== DATABASE ====================
# PostgreSQL connection
# For Docker: use host.docker.internal to access localhost
# For local development: use localhost
DB_HOST=host.docker.internal
DB_PORT=5432
DB_PASSWORD=your-secure-database-password

# ==================== JWT AUTHENTICATION ====================
# CHANGE THESE IN PRODUCTION!
# Secret must be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ISSUER=Watchmen.Api
JWT_AUDIENCE=Watchmen.Client

# ==================== SUPER ADMIN ====================
# Default admin account credentials
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=your-secure-admin-password

# ==================== SECURITY ====================
# Data encryption/hashing key
# Generate with: openssl rand -base64 32
HASHING_KEY=your-random-hashing-key-for-data-protection

# ==================== RATE LIMITING ====================
# Global rate limiting settings
RATE_LIMIT_PERMITS=100
RATE_LIMIT_WINDOW=1
RATE_LIMIT_QUEUE=0

# ==================== CACHING ====================
# Memory cache settings (in minutes)
CACHE_EXPIRATION=60

# ==================== PAGINATION ====================
# Maximum items per page
PAGINATION_SIZE=100

# ==================== OPENTELEMETRY ====================
# OTLP endpoint for traces (Jaeger)
# For Docker Compose: http://jaeger:4317
# For external: http://your-jaeger-host:4317
OTEL_ENDPOINT=http://jaeger:4317

# ==================== GRAFANA ====================
# Grafana dashboard credentials
# CHANGE PASSWORD IN PRODUCTION!
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-this-grafana-password

# ==================== ENVIRONMENT ====================
# Application environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Production

# ==================== API KEYS ====================
# NOTE: API keys are managed in apikeys.json
# See apikeys.example.json for structure
#
# To generate new API keys:
# 1. Run: dotnet run --project Tools/KeyGenerator
# 2. Copy output to apikeys.json
# 3. Update prometheus.yml with new metrics key
